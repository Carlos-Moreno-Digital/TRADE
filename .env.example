# ===========================================
# TRADE - Autonomous Trading Agent Config
# ===========================================
# Copy this file to .env and fill in your keys
# NEVER commit .env to git!

# Trading Mode (paper | live)
TRADE_MODE=paper

# OpenBB API Key (optional - for premium data)
# OPENBB_TOKEN=your_openbb_token_here

# Anthropic API Key (for sentiment analysis via Claude)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (alternative LLM for sentiment)
# OPENAI_API_KEY=sk-xxxxx

# Broker API Keys (only needed for live trading)
# ALPACA_API_KEY=your_alpaca_key
# ALPACA_SECRET_KEY=your_alpaca_secret
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Crypto Exchange (only needed for crypto trading)
# BINANCE_API_KEY=your_binance_key
# BINANCE_SECRET_KEY=your_binance_secret

# News API (for sentiment analysis)
# NEWS_API_KEY=your_newsapi_key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trade.log
