# ===========================================
# TRADE - Autonomous Trading Agent Config
# ===========================================
# Copy this file to .env and fill in your keys
# NEVER commit .env to git!

# Trading Mode (paper | live)
TRADE_MODE=paper

# OpenBB API Key (optional - for premium data)
# OPENBB_TOKEN=your_openbb_token_here

# Anthropic API Key (for sentiment analysis via Claude)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (alternative LLM for sentiment)
# OPENAI_API_KEY=sk-xxxxx

# TradeLocker (FunderPro) - REQUIRED for live trading
# Get credentials from your FunderPro/TradeLocker account
TRADELOCKER_USERNAME=your_email@example.com
TRADELOCKER_PASSWORD=your_tradelocker_password
TRADELOCKER_SERVER=FunderPro
TRADELOCKER_ENVIRONMENT=https://demo.tradelocker.com
# For live: TRADELOCKER_ENVIRONMENT=https://live.tradelocker.com

# Prop Firm Config
PROP_FIRM_CONFIG=funderpro_classic_10k

# News API (for sentiment analysis)
# NEWS_API_KEY=your_newsapi_key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trade.log
